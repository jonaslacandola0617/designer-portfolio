# PostgreSQL connection string. Use a pooler for application traffic.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
# Direct PostgreSQL connection used by migrations.
DIRECT_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://design.jonasl.online"
# Seed-only credentials; password must be 12–72 UTF-8 bytes. Never committed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional fictional development projects. Never enable for production seeding.
SEED_SAMPLES="false"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"
MAX_UPLOAD_MB="20"
# Only for loopback object storage in local tests. Never enabled on Vercel.
ALLOW_LOCAL_IMAGE_IP="false"
# Integration tests require a separate disposable database.
TEST_DATABASE_URL=""
